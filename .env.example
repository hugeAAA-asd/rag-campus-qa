# ============ 向量化方式 ============
# local = 用本地模型（不需要任何 key，默认）
# api   = 调远程 embedding 服务（需要 EMBED_API_KEY）
EMBED_PROVIDER=local

# ---- local 方式用到的配置 ----
LOCAL_MODEL_NAME=BAAI/bge-small-zh-v1.5

# ---- api 方式用到的配置（EMBED_PROVIDER=api 时才需要）----
EMBED_URL=https://api.siliconflow.cn/v1/embeddings
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=

# ============ 对话模型（DeepSeek）============
DEEPSEEK_CHAT_URL=https://api.deepseek.com/v1/chat/completions
CHAT_MODEL=deepseek-flash
DEEPSEEK_API_KEY=在这里填你的 DeepSeek key
# 思考模式：disabled 更快，文档问答用这个
CHAT_THINKING=disabled
# 每次检索取几块（默认 3）。调大召回更多，但更慢更贵
TOP_K=3
# 语料文件：corpus.txt（小，3块）或 corpus_big.txt（大，约20块）
CORPUS_FILE=corpus.txt
